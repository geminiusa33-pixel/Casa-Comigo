# Local ASP.NET Core API configuration. Copy values into the API process environment;
# this example file is not loaded automatically by `dotnet run`.
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__Supabase=Host=127.0.0.1;Port=54322;Database=postgres;Username=postgres;Password=postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_ISSUER=supabase
# Set from `npx supabase status` in the process environment. Never commit the value.
# This is the local JWT signing secret, not the Supabase API secret/service_role key.
# SUPABASE_JWT_SECRET=
