# Server-only settings for an ASP.NET Core API connecting to hosted Supabase.
# Configure these in the API host's secret/environment-variable settings, not Git.
ASPNETCORE_URLS=http://localhost:5080
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Use the database connection string from the Supabase project dashboard.
# Keep its database password private; choose the pooler URL if the host requires it.
ConnectionStrings__Supabase=<server-only-supabase-postgres-connection-string>
# Never put a Supabase publishable/anon key, secret key, service_role key, or
# database password in frontend variables. SUPABASE_JWT_SECRET is a legacy JWT
# signing secret, not the Supabase API secret key; leave it unset for hosted
# projects using asymmetric JWT signing keys.
# SUPABASE_JWT_SECRET=
