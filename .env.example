# Local Docker Supabase settings for the Vite frontend.
# Copy to services/web/.env.local. Only the public anon key belongs in the browser.
VITE_API_BASE_URL=http://localhost:5080
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Optional public Stripe Payment Links created in the Stripe Dashboard.
# These are URLs, not secret API keys. Leave empty until the links are configured.
VITE_STRIPE_COFFEE_3_URL=
VITE_STRIPE_COFFEE_5_URL=
VITE_STRIPE_COFFEE_10_URL=
