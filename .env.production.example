# Frontend build settings for a hosted Supabase project.
# Replace placeholders in your hosting provider's environment settings.
# The publishable/anon key is intended for browser use; enable and verify RLS.
VITE_API_BASE_URL=https://<your-api-host>
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-project-publishable-or-anon-key>
# Optional public Stripe Payment Links (never put Stripe secret keys here).
VITE_STRIPE_COFFEE_3_URL=
VITE_STRIPE_COFFEE_5_URL=
VITE_STRIPE_COFFEE_10_URL=
